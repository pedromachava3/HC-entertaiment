# ---------------------------------------------------------------
# HC Entertainment — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# NUNCA coloque valores reais neste ficheiro nem no repositório.
# ---------------------------------------------------------------

# URL público do site (sem barra final). Ex.: https://hc-entertainment.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave pública (anon / publishable)>

# SEGREDO — só no servidor. Supabase → Project Settings → API Keys → service_role (ou secret key)
SUPABASE_SERVICE_ROLE_KEY=

# SEGREDO — assinatura dos QR Codes (mín. 32 caracteres aleatórios).
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ATENÇÃO: alterar este valor invalida todos os QR Codes já emitidos.
TICKET_SIGNING_SECRET=

# SEGREDO — protege o endpoint do Vercel Cron (/api/cron/expire-orders)
CRON_SECRET=

# Prazo para pagar uma encomenda antes de expirar (minutos). Padrão: 2880 (48 h)
ORDER_PENDING_TTL_MINUTES=2880

# Pagamento automático (PaySuite — M-Pesa / e-Mola / mKesh). Sem estes valores, só o pagamento manual fica activo.
# Painel PaySuite → token da API e Webhook Token (whsec_...). O URL do webhook é enviado em cada pagamento:
#   https://<domínio>/api/webhooks/paysuite
PAYSUITE_API_TOKEN=
PAYSUITE_WEBHOOK_SECRET=
# PAYSUITE_API_URL=https://paysuite.tech/api/v1
